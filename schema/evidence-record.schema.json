{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/edgeloom-oss/edgeloom/schema/v0.1/evidence-record.schema.json",
  "title": "EdgeLoom evidence record",
  "description": "A versioned record of artifact identity, deterministic checks, semantic mapping evidence, transformations, recovery, and human disposition. The record preserves evidence and limitations; it is not a certification or conformance claim.",
  "type": "object",
  "required": [
    "record_version",
    "record_id",
    "created_at",
    "tool",
    "subject",
    "checks",
    "limitations"
  ],
  "additionalProperties": false,
  "properties": {
    "record_version": {
      "const": "0.1",
      "description": "Version of this evidence-record contract."
    },
    "record_id": {
      "type": "string",
      "pattern": "^elr-[a-f0-9]{24}$",
      "description": "Stable identifier derived from the audited bytes, check policy, and supplied source metadata."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "tool": {
      "$ref": "#/$defs/tool"
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "mappings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mapping"
      }
    },
    "transformation": {
      "$ref": "#/$defs/transformation"
    },
    "review": {
      "$ref": "#/$defs/review"
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "object",
      "required": ["algorithm", "value"],
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "value": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "tool": {
      "type": "object",
      "required": ["name", "version", "policy_version"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "edgeloom"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "policy_version": {
          "const": "audit-0.1"
        }
      }
    },
    "subject": {
      "type": "object",
      "required": ["path", "digest", "size_bytes", "status"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Path supplied to the local audit command; it is not proof of remote origin."
        },
        "uri": {
          "type": "string",
          "minLength": 1,
          "description": "Asserted canonical or retrieval URI, recorded without fetching or authentication."
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "description": "Pinned revision, tag, commit, version, or other source identifier."
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "description": "Asserted license identifier or expression; EdgeLoom does not verify rights."
        },
        "status": {
          "type": "string",
          "enum": ["experimental", "draft", "stable", "deprecated", "unknown"]
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "check": {
      "type": "object",
      "required": ["id", "status", "authority", "summary"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "status": {
          "type": "string",
          "enum": ["pass", "fail", "skipped", "error"]
        },
        "authority": {
          "type": "string",
          "enum": ["deterministic", "normative", "informative", "user-supplied"]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "mapping": {
      "type": "object",
      "required": ["source", "target", "classification", "rationale"],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": ["string", "null"]
        },
        "classification": {
          "type": "string",
          "enum": ["one-to-one", "lossy", "ambiguous", "unbound"]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "transformation": {
      "type": "object",
      "required": ["operation", "before", "after", "recovery_status"],
      "additionalProperties": false,
      "properties": {
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "before": {
          "$ref": "#/$defs/digest"
        },
        "after": {
          "$ref": "#/$defs/digest"
        },
        "recovery_status": {
          "type": "string",
          "enum": ["not-tested", "pass", "fail", "partial"]
        },
        "recovered": {
          "$ref": "#/$defs/digest"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "review": {
      "type": "object",
      "required": ["disposition"],
      "additionalProperties": false,
      "properties": {
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "disposition": {
          "type": "string",
          "enum": ["unreviewed", "accepted", "rejected", "needs-work"]
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
