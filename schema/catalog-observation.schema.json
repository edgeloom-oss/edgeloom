{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/edgeloom-oss/edgeloom/schema/draft/v0.1/catalog-observation.schema.json",
  "title": "EdgeLoom Reported observation (draft v0.1)",
  "description": "Draft v0.1. Candidate declarations; structural checks do not authenticate evidence or review.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "id",
    "subject",
    "feature_id",
    "method",
    "data_origin",
    "environment",
    "procedure",
    "expected",
    "observed",
    "outcome",
    "repetitions",
    "observed_at",
    "reported_by",
    "evidence",
    "review",
    "limitations"
  ],
  "properties": {
    "kind": {
      "const": "catalog-observation"
    },
    "schema_version": {
      "const": "0.1"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "feature_id": {
      "$ref": "#/$defs/id"
    },
    "method": {
      "enum": [
        "physical-device",
        "simulation"
      ]
    },
    "data_origin": {
      "enum": [
        "community-report",
        "synthetic-example"
      ]
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "platform_version",
        "driver_revision",
        "setup"
      ],
      "properties": {
        "platform": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "platform_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "driver_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "setup": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      }
    },
    "procedure": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      }
    },
    "expected": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "observed": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "outcome": {
      "enum": [
        "pass",
        "fail",
        "inconclusive"
      ]
    },
    "repetitions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "reported_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "evidence": {
      "type": "array",
      "minItems": 0,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "description"
        ],
        "properties": {
          "url": {
            "$ref": "#/$defs/url"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lifecycle"
      ],
      "properties": {
        "lifecycle": {
          "const": "candidate"
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,119}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^\\s]+$",
      "maxLength": 2000
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manufacturer",
        "model",
        "protocol",
        "identifiers",
        "firmware",
        "scope_notes"
      ],
      "properties": {
        "manufacturer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "protocol": {
          "enum": [
            "zwave",
            "zigbee",
            "other",
            "unknown"
          ]
        },
        "identifiers": {
          "type": "object",
          "maxProperties": 20,
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "firmware": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "scope_notes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        }
      }
    },
    "ids": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "pointer": {
      "type": "string",
      "pattern": "^#(?:/.*)?$",
      "maxLength": 1000
    },
    "record_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "locator",
        "relationship"
      ],
      "properties": {
        "record_id": {
          "$ref": "#/$defs/id"
        },
        "locator": {
          "$ref": "#/$defs/pointer"
        },
        "relationship": {
          "enum": [
            "supports",
            "conflicts",
            "context",
            "unresolved"
          ]
        }
      }
    },
    "path": {
      "type": "string",
      "pattern": "^catalog/[a-z-]+/[A-Za-z0-9][A-Za-z0-9._/-]*\\.(json|yaml|yml)$",
      "maxLength": 1000
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "data_origin": {
            "const": "synthetic-example"
          }
        }
      },
      "then": {
        "properties": {
          "method": {
            "const": "simulation"
          }
        }
      }
    }
  ]
}
